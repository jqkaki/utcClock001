{
  "manifest_version": 3,
  "name": "UTC Clock",
  "version": "2.0.0",
  "description": "A tiny pink UTC clock.",
  "icons": {
    "16": "pclock.png",
    "48": "pclock.png",
    "128": "pclock.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
